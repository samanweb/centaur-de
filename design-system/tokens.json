{
  "meta": {
    "name": "Centaur",
    "version": "1.0.0",
    "prefix": "centaur",
    "description": "Single source of truth for Centaur DE styling. Generated into GTK4 CSS by tools/generate.py. Nothing in libcentaur-ui may reference a literal colour."
  },

  "modes": {
    "dark": { "palette": "dark", "label": "Dark", "description": "Default. Dark blue-black surfaces." },
    "pure-dark": { "palette": "pure-dark", "label": "Pure Dark", "description": "OLED blackout. True black window background." },
    "light": { "palette": "light", "label": "Light Style", "description": "Daylight contrast." },
    "auto": { "palette": null, "label": "Auto Scheduled", "description": "Switches between dark and light on the sunrise/sunset schedule. Resolved by centaur-settingsd; never emitted as its own stylesheet." }
  },

  "palettes": {
    "dark": {
      "surface": {
        "window":     "#0b0f14",
        "sidebar":    "#0e1319",
        "card":       "#151b23",
        "card-hover": "#1a2029",
        "raised":     "#1b222b",
        "overlay":    "#1a212a",
        "topbar":     "#0a0e12",
        "scrim":      "rgba(0, 0, 0, 0.60)"
      },
      "border": {
        "subtle": "#1f2730",
        "default": "#2a333e",
        "strong":  "#3a4550"
      },
      "text": {
        "primary":   "#e6edf3",
        "secondary": "#a9b6c3",
        "muted":     "#6e7d8c",
        "disabled":  "#4a5561",
        "inverse":   "#0b0f14"
      },
      "control": {
        "track":         "#232c36",
        "track-disabled":"#191f27",
        "thumb":         "#e6edf3",
        "fill":          "#2a333e"
      },
      "status": {
        "success": "#35d399",
        "warning": "#fbbf24",
        "danger":  "#fb7185",
        "info":    "#60a5fa"
      },
      "accent-steps": { "base": "400", "bright": "300", "dim": "600", "ink": "ink" },
      "tint-alpha": 0.14
    },

    "pure-dark": {
      "surface": {
        "window":     "#000000",
        "sidebar":    "#000000",
        "card":       "#0a0d10",
        "card-hover": "#101418",
        "raised":     "#101418",
        "overlay":    "#0a0d10",
        "topbar":     "#000000",
        "scrim":      "rgba(0, 0, 0, 0.72)"
      },
      "border": {
        "subtle": "#161b21",
        "default": "#222a31",
        "strong":  "#333d46"
      },
      "text": {
        "primary":   "#f0f4f8",
        "secondary": "#aab7c4",
        "muted":     "#72808e",
        "disabled":  "#4c5663",
        "inverse":   "#000000"
      },
      "control": {
        "track":          "#1a2027",
        "track-disabled": "#11161b",
        "thumb":          "#f0f4f8",
        "fill":           "#222a31"
      },
      "status": {
        "success": "#35d399",
        "warning": "#fbbf24",
        "danger":  "#fb7185",
        "info":    "#60a5fa"
      },
      "accent-steps": { "base": "400", "bright": "300", "dim": "600", "ink": "ink" },
      "tint-alpha": 0.16
    },

    "light": {
      "surface": {
        "window":     "#f4f6f8",
        "sidebar":    "#eceff2",
        "card":       "#ffffff",
        "card-hover": "#f7f9fa",
        "raised":     "#f0f3f5",
        "overlay":    "#ffffff",
        "topbar":     "#ffffff",
        "scrim":      "rgba(15, 23, 31, 0.35)"
      },
      "border": {
        "subtle": "#e2e7eb",
        "default": "#ccd4db",
        "strong":  "#aab6c0"
      },
      "text": {
        "primary":   "#10161c",
        "secondary": "#46535f",
        "muted":     "#6b7885",
        "disabled":  "#9aa5b0",
        "inverse":   "#ffffff"
      },
      "control": {
        "track":          "#d8dee4",
        "track-disabled": "#e8ecef",
        "thumb":          "#ffffff",
        "fill":           "#ccd4db"
      },
      "status": {
        "success": "#059669",
        "warning": "#b45309",
        "danger":  "#e11d48",
        "info":    "#2563eb"
      },
      "accent-steps": { "base": "700", "bright": "600", "dim": "800", "ink": "auto" },
      "tint-alpha": 0.10
    }
  },

  "accents": {
    "emerald": { "label": "Emerald", "default": true,
      "300": "#6ee7b7", "400": "#35d399", "500": "#10b981", "600": "#059669", "700": "#047857", "800": "#065f46", "ink": "#04231a" },
    "blue":    { "label": "Blue",
      "300": "#93c5fd", "400": "#60a5fa", "500": "#3b82f6", "600": "#2563eb", "700": "#1d4ed8", "800": "#1e40af", "ink": "#0a1834" },
    "cyan":    { "label": "Cyan",
      "300": "#67e8f9", "400": "#22d3ee", "500": "#06b6d4", "600": "#0891b2", "700": "#0e7490", "800": "#155e75", "ink": "#042f36" },
    "purple":  { "label": "Purple",
      "300": "#c4b5fd", "400": "#a78bfa", "500": "#8b5cf6", "600": "#7c3aed", "700": "#6d28d9", "800": "#5b21b6", "ink": "#1b0f36" },
    "amber":   { "label": "Amber",
      "300": "#fcd34d", "400": "#fbbf24", "500": "#f59e0b", "600": "#d97706", "700": "#b45309", "800": "#92400e", "ink": "#2b1a02" },
    "orange":  { "label": "Orange",
      "300": "#fdba74", "400": "#fb923c", "500": "#f97316", "600": "#ea580c", "700": "#c2410c", "800": "#9a3412", "ink": "#2b1206" },
    "slate":   { "label": "Slate",
      "300": "#cbd5e1", "400": "#94a3b8", "500": "#64748b", "600": "#475569", "700": "#334155", "800": "#1e293b", "ink": "#0b1220" },
    "crimson": { "label": "Crimson",
      "300": "#fda4af", "400": "#fb7185", "500": "#f43f5e", "600": "#e11d48", "700": "#be123c", "800": "#9f1239", "800": "#9f1239", "ink": "#2d0611" }
  },

  "scale": {
    "space": {
      "xs": "2px", "sm": "4px", "md": "8px", "lg": "12px",
      "xl": "16px", "2xl": "24px", "3xl": "32px", "4xl": "48px"
    },
    "radius": {
      "sm": "6px", "md": "10px", "lg": "14px", "xl": "20px", "pill": "999px"
    },
    "border-width": { "hairline": "1px", "thick": "2px" },
    "font": {
      "family-ui":   "Inter, 'Noto Sans', sans-serif",
      "family-mono": "'JetBrains Mono', 'Noto Sans Mono', monospace",
      "size-caption":  "11px",
      "size-small":    "12px",
      "size-body":     "13px",
      "size-body-lg":  "14px",
      "size-title":    "16px",
      "size-title-lg": "20px",
      "size-display":  "28px",
      "weight-regular":  "400",
      "weight-medium":   "500",
      "weight-semibold": "600",
      "weight-bold":     "700"
    },
    "motion": {
      "duration-instant": "0ms",
      "duration-fast":    "120ms",
      "duration-base":    "180ms",
      "duration-slow":    "260ms",
      "easing-standard":  "cubic-bezier(0.2, 0, 0, 1)",
      "easing-decelerate":"cubic-bezier(0, 0, 0, 1)"
    },
    "layout": {
      "topbar-height":    "32px",
      "sidebar-width":    "220px",
      "card-padding":     "16px",
      "row-height":       "40px",
      "row-height-compact":"32px",
      "icon-sm":          "16px",
      "icon-md":          "20px",
      "icon-lg":          "24px",
      "focus-ring-width": "2px",
      "content-max-width":"1100px"
    }
  }
}
