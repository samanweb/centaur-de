
/* ===========================================================================
   Centaur DE — component rules
   ---------------------------------------------------------------------------
   Colours are @define-color references so centaur-settingsd can swap the accent
   block at runtime. Lengths are substituted from tokens.json at build time,
   because GTK4 CSS has no variable mechanism for lengths.

   Load order matters and is fixed:
       accents/<accent>-<palette>.css     (accent block, first)
       tokens-<palette>.css               (palette block)
       components.css                     (these rules)
   =========================================================================== */

/* --- base ---------------------------------------------------------------- */

window,
.centaur-window {
  background-color: @centaur_surface_window;
  color: @centaur_text_primary;
  font-family: {{font.family-ui}};
  font-size: {{font.size-body}};
}

label { color: @centaur_text_primary; }
label.dim  { color: @centaur_text_secondary; }
label.muted { color: @centaur_text_muted; }
label.mono { font-family: {{font.family-mono}}; }

.title-lg {
  font-size: {{font.size-title-lg}};
  font-weight: {{font.weight-semibold}};
}
.title {
  font-size: {{font.size-title}};
  font-weight: {{font.weight-semibold}};
}
.caption {
  font-size: {{font.size-caption}};
  color: @centaur_text_muted;
}
.section-heading {
  font-size: {{font.size-caption}};
  font-weight: {{font.weight-semibold}};
  color: @centaur_text_muted;
  letter-spacing: 0.06em;
}

*:disabled,
.centaur-unavailable {
  color: @centaur_text_disabled;
}

/* Focus is one ring everywhere. Never remove it without replacing it. */
*:focus-visible {
  outline: {{layout.focus-ring-width}} solid @centaur_accent_base;
  outline-offset: {{space.xs}};
}

/* --- topbar (module 01) --------------------------------------------------- */

/* Tabular figures keep the clock and percentages from shifting the bar a
   pixel every time a digit changes. */
.centaur-topbar {
  background-color: @centaur_surface_topbar;
  border-bottom: {{border-width.hairline}} solid @centaur_border_subtle;
  min-height: {{layout.topbar-height}};
  padding: 0 {{space.sm}};
  font-family: {{font.family-ui}};
  font-size: {{font.size-small}};
  font-weight: {{font.weight-medium}};
  font-feature-settings: "tnum";
}

.centaur-topbar > centerbox > box { border-spacing: {{space.xs}}; }

.centaur-indicator {
  min-height: {{layout.icon-lg}};
  margin: {{space.sm}} 0;
  padding: 0 {{space.md}};
  border-radius: {{radius.sm}};
  color: @centaur_text_secondary;
  border-spacing: {{space.md}};
  transition: background-color {{motion.duration-fast}} {{motion.easing-standard}},
              color {{motion.duration-fast}} {{motion.easing-standard}};
}
.centaur-indicator:hover  {
  background-color: @centaur_surface_card_hover;
  color: @centaur_text_primary;
}
.centaur-indicator:active,
.centaur-indicator.active { color: @centaur_text_primary; }

/* A menubutton draws through its inner toggle button, so the indicator's
   padding and hover move down one node, and stay lit while the menu is open. */
menubutton.centaur-indicator,
menubutton.centaur-indicator:hover {
  padding: 0;
  background-color: transparent;
}
menubutton.centaur-indicator > button {
  min-height: {{layout.icon-lg}};
  padding: 0 {{space.md}};
  border-radius: {{radius.sm}};
  border-color: transparent;
  background-color: transparent;
  box-shadow: none;
  color: inherit;
}
menubutton.centaur-indicator > button:hover,
menubutton.centaur-indicator > button:checked {
  background-color: @centaur_surface_card_hover;
  color: @centaur_text_primary;
}

/* Colour reinforces a state the icon already shows; it never carries it. */
.centaur-indicator.warning { color: @centaur_status_warning; }
.centaur-indicator.danger  { color: @centaur_status_danger; }

.centaur-indicator image { -gtk-icon-size: {{layout.icon-sm}}; }

.centaur-launcher-button image { color: @centaur_accent_base; }

.centaur-clock { color: @centaur_text_primary; }

.centaur-workspace {
  min-width: {{layout.icon-lg}};
  min-height: {{layout.icon-lg}};
  margin: {{space.sm}} 0;
  padding: 0 {{space.sm}};
  border-radius: {{radius.sm}};
  color: @centaur_text_muted;
}
.centaur-workspace.occupied { color: @centaur_text_secondary; }
.centaur-workspace.active {
  background-color: @centaur_accent_bg;
  color: @centaur_accent_base;
  font-weight: {{font.weight-semibold}};
}

/* Running applications. Focus is a fill plus an accent underline, and a fully
   minimised app is dimmed, so all three states read without colour. */
.centaur-taskbar {
  margin-left: {{space.sm}};
  border-spacing: {{space.xs}};
}
/* An indicator with nothing to show stays mapped (it subscribes on map) and
   collapses to nothing instead of hiding. */
.centaur-taskbar.empty,
.centaur-indicator.empty {
  margin-left: 0;
  margin-right: 0;
  padding: 0;
}

.centaur-task {
  min-width: {{layout.icon-lg}};
  min-height: {{layout.icon-lg}};
  margin: {{space.sm}} 0;
  padding: 0 {{space.sm}};
  border-radius: {{radius.sm}};
  transition: background-color {{motion.duration-fast}} {{motion.easing-standard}};
}
.centaur-task.active {
  background-color: @centaur_surface_card_hover;
  box-shadow: inset 0 -{{border-width.thick}} @centaur_accent_base;
}
.centaur-task.minimized image { opacity: 0.5; }

.centaur-focused-window {
  color: @centaur_text_secondary;
  font-weight: {{font.weight-regular}};
}
.centaur-focused-window:hover { background-color: transparent; }

.centaur-topbar-menu > contents { padding: {{space.sm}}; }

.centaur-menu-item {
  min-height: {{layout.row-height-compact}};
  min-width: 180px;
  padding: 0 {{space.md}};
  border-radius: {{radius.sm}};
  font-weight: {{font.weight-regular}};
}
.centaur-menu-item box { border-spacing: {{space.lg}}; }
.centaur-menu-item.danger {
  background-color: transparent;
  border-color: transparent;
  color: @centaur_status_danger;
}
.centaur-menu-item.danger:hover { background-color: @centaur_status_danger_bg; }

.centaur-calendar-heading {
  padding: {{space.sm}} {{space.md}} {{space.md}};
  font-size: {{font.size-body}};
  font-weight: {{font.weight-semibold}};
  color: @centaur_text_primary;
}

calendar.centaur-calendar {
  background-color: transparent;
  border: none;
  color: @centaur_text_primary;
  font-feature-settings: "tnum";
}
calendar.centaur-calendar > header { border: none; background-color: transparent; }
calendar.centaur-calendar > header > button {
  background-color: transparent;
  border-color: transparent;
  box-shadow: none;
  border-radius: {{radius.sm}};
}
calendar.centaur-calendar > header > button:hover { background-color: @centaur_surface_card_hover; }
calendar.centaur-calendar > grid > label {
  min-width: {{layout.row-height-compact}};
  min-height: {{layout.row-height-compact}};
  margin: 1px;
  border-radius: {{radius.sm}};
}
calendar.centaur-calendar > grid > label.day-name {
  color: @centaur_text_muted;
  font-size: {{font.size-caption}};
}
calendar.centaur-calendar > grid > label.other-month { color: @centaur_text_disabled; }
calendar.centaur-calendar > grid > label.today {
  color: @centaur_accent_base;
  font-weight: {{font.weight-semibold}};
  box-shadow: none;
}
calendar.centaur-calendar > grid > label:selected {
  background-color: @centaur_accent_base;
  color: @centaur_accent_ink;
}

.centaur-topbar-menu separator { margin: {{space.sm}} {{space.xs}}; }

.centaur-badge {
  background-color: @centaur_accent_base;
  color: @centaur_accent_ink;
  border-radius: {{radius.pill}};
  font-size: {{font.size-caption}};
  font-weight: {{font.weight-semibold}};
  padding: 0 {{space.sm}};
  min-width: {{layout.icon-sm}};
}

/* --- display settings (centaur-displays) ------------------------------------ */

.centaur-display-canvas {
  background-color: @centaur_surface_window;
  border: {{border-width.hairline}} solid @centaur_border_subtle;
  border-radius: {{radius.md}};
}

/* A monitor in the arrangement. Selection is a thicker accent border and an
   accent tint, so it still reads in a monochrome screenshot. */
.centaur-display-tile {
  background-color: @centaur_surface_raised;
  border: {{border-width.hairline}} solid @centaur_border_strong;
  border-radius: {{radius.sm}};
  padding: {{space.xs}};
}
.centaur-display-tile:hover { background-color: @centaur_surface_card_hover; }
.centaur-display-tile.selected {
  background-color: @centaur_accent_bg;
  border: {{border-width.thick}} solid @centaur_accent_base;
}
.centaur-display-tile-name {
  font-weight: {{font.weight-semibold}};
  font-size: {{font.size-small}};
}

/* --- background settings (centaur-background) ------------------------------ */

.centaur-wallpaper-preview {
  border: {{border-width.hairline}} solid @centaur_border_default;
  border-radius: {{radius.lg}};
}

.centaur-wallpaper-grid > flowboxchild {
  padding: {{space.xs}};
  border-radius: {{radius.md}};
  outline: none;
}
.centaur-wallpaper {
  border: {{border-width.hairline}} solid @centaur_border_subtle;
  border-radius: {{radius.sm}};
  background-color: @centaur_surface_raised;
  transition: border-color {{motion.duration-fast}} {{motion.easing-standard}};
}
.centaur-wallpaper-grid > flowboxchild:hover .centaur-wallpaper {
  border-color: @centaur_border_strong;
}
/* Selection is a thick accent ring outside the picture, never a tint over
   it: the picture is what is being judged. */
.centaur-wallpaper-grid > flowboxchild:selected {
  background-color: transparent;
  box-shadow: 0 0 0 {{border-width.thick}} @centaur_accent_base;
}
.centaur-wallpaper-grid > flowboxchild:focus-visible {
  box-shadow: 0 0 0 {{border-width.thick}} @centaur_accent_bright;
}

/* --- screenshot (centaur-screenshot) --------------------------------------- */

.centaur-screenshot-mode {
  min-width: 96px;
  padding: {{space.lg}} {{space.md}};
  border-radius: {{radius.md}};
}
.centaur-screenshot-mode:checked {
  background-color: @centaur_accent_bg;
  border-color: @centaur_accent_base;
  color: @centaur_accent_base;
}

/* The confirmation card is its own layer-shell surface, so the window behind
   it must be transparent for the card's rounded corners to show. */
/* GTK's built-in theme paints window.background and a decoration shadow on
   every toplevel; both would show as a light box around the rounded card. */
window.centaur-screenshot-toast,
window.centaur-screenshot-toast.background {
  background: none;
  box-shadow: none;
  border: none;
}
.centaur-screenshot-card {
  background-color: @centaur_surface_overlay;
  border: {{border-width.hairline}} solid @centaur_border_default;
  border-radius: {{radius.lg}};
  padding: {{space.sm}} {{space.lg}} {{space.lg}};
  margin: {{space.xs}};
}
.centaur-screenshot-card.danger { border-color: @centaur_status_danger; }
.centaur-screenshot-heading {
  font-weight: {{font.weight-semibold}};
  font-size: {{font.size-body-lg}};
}
.centaur-screenshot-thumb {
  border: {{border-width.hairline}} solid @centaur_border_subtle;
  border-radius: {{radius.sm}};
}
.centaur-screenshot-close {
  min-width: {{layout.icon-lg}};
  min-height: {{layout.icon-lg}};
  padding: 0;
  margin-right: -{{space.md}};
  border-radius: {{radius.pill}};
}

/* --- card ----------------------------------------------------------------- */

.centaur-card {
  background-color: @centaur_surface_card;
  border: {{border-width.hairline}} solid @centaur_border_subtle;
  border-radius: {{radius.lg}};
  padding: {{layout.card-padding}};
}
.centaur-card:hover { background-color: @centaur_surface_card_hover; }

.centaur-card-header {
  font-size: {{font.size-body-lg}};
  font-weight: {{font.weight-semibold}};
  margin-bottom: {{space.lg}};
}

.centaur-card.accent { border-color: @centaur_accent_dim; }
.centaur-card.danger { border-color: @centaur_status_danger; }

/* --- rows ----------------------------------------------------------------- */

.centaur-row {
  min-height: {{layout.row-height}};
  padding: {{space.md}} 0;
}
.centaur-row + .centaur-row {
  border-top: {{border-width.hairline}} solid @centaur_border_subtle;
}
.centaur-row-title    { font-weight: {{font.weight-medium}}; }
.centaur-row-subtitle {
  font-size: {{font.size-small}};
  color: @centaur_text_muted;
}

/* --- controls ------------------------------------------------------------- */

switch {
  background-color: @centaur_control_track;
  border: none;
  border-radius: {{radius.pill}};
  transition: background-color {{motion.duration-base}} {{motion.easing-standard}};
}
switch:checked  { background-color: @centaur_accent_base; }
switch:disabled { background-color: @centaur_control_track_disabled; }
switch slider {
  background-image: none;
  box-shadow: none;
  border: none;
  background-color: @centaur_control_thumb;
  border-radius: {{radius.pill}};
}

scale trough {
  background-color: @centaur_control_track;
  border-radius: {{radius.pill}};
  min-height: {{space.sm}};
}
scale highlight {
  background-color: @centaur_accent_base;
  border-radius: {{radius.pill}};
}
scale slider {
  background-color: @centaur_control_thumb;
  border-radius: {{radius.pill}};
  min-width: {{layout.icon-sm}};
  min-height: {{layout.icon-sm}};
}

/* GTK's built-in theme paints buttons with a background-image gradient in
   every state, drawn over background-color -- so without this reset none of
   the colours below are ever seen, and buttons come out light-on-light. */
button,
button:hover,
button:active,
button:checked,
button:disabled,
button:backdrop {
  background-image: none;
  box-shadow: none;
  text-shadow: none;
}

button {
  background-color: @centaur_control_fill;
  color: @centaur_text_primary;
  border: {{border-width.hairline}} solid @centaur_border_default;
  border-radius: {{radius.md}};
  padding: {{space.md}} {{space.lg}};
  font-weight: {{font.weight-medium}};
  transition: background-color {{motion.duration-fast}} {{motion.easing-standard}};
}
button:hover    { background-color: @centaur_surface_raised; }
button:disabled { color: @centaur_text_disabled; }

button.accent {
  background-color: @centaur_accent_base;
  color: @centaur_accent_ink;
  border-color: @centaur_accent_base;
}
button.accent:hover { background-color: @centaur_accent_bright; }

/* A button's label and icon take the button's colour. Without this the base
   `label` rule wins, and every accent button shows text.primary -- light text
   on a light accent -- instead of the accent ink chosen for contrast. */
button label,
button image { color: inherit; }
/* A disabled accent button must not still look like the thing to press. */
button.accent:disabled {
  background-color: @centaur_control_fill;
  border-color: @centaur_border_default;
  color: @centaur_text_disabled;
}

button.danger {
  background-color: @centaur_status_danger_bg;
  color: @centaur_status_danger;
  border-color: @centaur_status_danger;
}

button.flat {
  background-color: transparent;
  border-color: transparent;
  color: @centaur_text_secondary;
}
button.flat:hover { background-color: @centaur_surface_card_hover; }

button.pill { border-radius: {{radius.pill}}; }

button:checked { background-color: @centaur_surface_raised; }

/* The title bar of Centaur's own windows. */
headerbar {
  background-color: @centaur_surface_sidebar;
  background-image: none;
  color: @centaur_text_primary;
  border-bottom: {{border-width.hairline}} solid @centaur_border_subtle;
  box-shadow: none;
  min-height: {{layout.row-height}};
}
headerbar:backdrop { background-color: @centaur_surface_window; }
headerbar .title {
  font-weight: {{font.weight-semibold}};
  color: @centaur_text_primary;
}
headerbar windowcontrols button {
  background-color: transparent;
  border-color: transparent;
  padding: {{space.sm}};
  min-width: {{layout.icon-lg}};
  min-height: {{layout.icon-lg}};
  border-radius: {{radius.pill}};
}
headerbar windowcontrols button:hover { background-color: @centaur_surface_card_hover; }

/* --- data display --------------------------------------------------------- */

.centaur-stat-tile {
  background-color: @centaur_surface_raised;
  border-radius: {{radius.md}};
  padding: {{space.lg}};
}
.centaur-stat-value {
  font-size: {{font.size-display}};
  font-weight: {{font.weight-semibold}};
  font-family: {{font.family-mono}};
}
.centaur-stat-label {
  font-size: {{font.size-caption}};
  color: @centaur_text_muted;
}

/* MeterRing draws its arc in code and reads this one `color` property.
   The unfilled track is that same colour at 18% alpha, derived in the widget:
   a ring is a single drawing area, so a second CSS class could not reach it. */
.centaur-meter-ring         { color: @centaur_accent_base; }
.centaur-meter-ring.warning { color: @centaur_status_warning; }
.centaur-meter-ring.danger  { color: @centaur_status_danger; }

progressbar trough {
  background-color: @centaur_control_track;
  border-radius: {{radius.pill}};
}
progressbar progress {
  background-color: @centaur_accent_base;
  border-radius: {{radius.pill}};
}

/* --- status chips --------------------------------------------------------- */

.centaur-chip {
  border-radius: {{radius.pill}};
  padding: {{space.xs}} {{space.md}};
  font-size: {{font.size-caption}};
  font-weight: {{font.weight-medium}};
}
.centaur-chip.success { background-color: @centaur_status_success_bg; color: @centaur_status_success; }
.centaur-chip.warning { background-color: @centaur_status_warning_bg; color: @centaur_status_warning; }
.centaur-chip.danger  { background-color: @centaur_status_danger_bg;  color: @centaur_status_danger;  }
.centaur-chip.info    { background-color: @centaur_status_info_bg;    color: @centaur_status_info;    }
.centaur-chip.accent  { background-color: @centaur_accent_bg;         color: @centaur_accent_base;    }

/* --- surfaces ------------------------------------------------------------- */

popover > contents {
  background-color: @centaur_surface_overlay;
  border: {{border-width.hairline}} solid @centaur_border_default;
  border-radius: {{radius.lg}};
  padding: {{space.md}};
}

tooltip {
  background-color: @centaur_surface_overlay;
  border-radius: {{radius.sm}};
  color: @centaur_text_primary;
  font-size: {{font.size-small}};
}

separator {
  background-color: @centaur_border_subtle;
  min-width: {{border-width.hairline}};
  min-height: {{border-width.hairline}};
}
