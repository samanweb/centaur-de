install_data('schemas/org.centaur.gschema.xml',
  install_dir: datadir / 'glib-2.0' / 'schemas')

install_data('dbus/org.centaur.System1.conf',
  install_dir: datadir / 'dbus-1' / 'system.d')

install_data('dbus/org.centaur.System1.service',
  install_dir: datadir / 'dbus-1' / 'system-services')

install_data('polkit/org.centaur.system1.policy',
  install_dir: datadir / 'polkit-1' / 'actions')

install_data('systemd/centaur-sysd.service',
  install_dir: prefix / 'lib' / 'systemd' / 'system')

install_data('sessions/centaur.desktop',
  install_dir: datadir / 'wayland-sessions')

install_data('applications/centaur-displays.desktop',
  install_dir: datadir / 'applications')

install_data('applications/centaur-background.desktop',
  install_dir: datadir / 'applications')

install_data('applications/centaur-screenshot.desktop',
  install_dir: datadir / 'applications')

# Wallpapers generated from the design tokens, in the conventional location so
# other desktops' tools find them too.
install_subdir('backgrounds', install_dir: datadir / 'backgrounds' / 'centaur',
               strip_directory: true)

# The launcher's mark. Every other topbar icon is a freedesktop name, so it
# follows the user's icon theme instead of shipping a private copy.
install_subdir('icons/hicolor', install_dir: datadir / 'icons')

# labwc themes generated from the design tokens, one per palette and accent,
# in the standard themes directory where labwc looks for them.
install_subdir('labwc-themes', install_dir: datadir / 'themes', strip_directory: true)

# Stylesheets generated by design-system/tools/generate.py. They are committed
# rather than generated during the build so that packaging needs no Python.
install_subdir('themes', install_dir: pkgdatadir)

# The design system's own gates, wired in as meson tests so a stale or
# inaccessible palette fails `meson test` rather than shipping.
python = find_program('python3', required: false)
design_system = meson.project_source_root() / '..' / 'design-system'

if python.found()
  test('design-system-generated-output-is-current',
    python,
    args: [design_system / 'tools' / 'generate.py',
           '--out', meson.current_source_dir() / 'themes',
           '--check'],
    suite: 'design-system')

  test('design-system-contrast',
    python,
    args: [design_system / 'tools' / 'check_contrast.py'],
    suite: 'design-system')
endif
